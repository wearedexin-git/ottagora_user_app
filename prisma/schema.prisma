generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// 1. User & Security
model User {
  id                    String             @id @default(cuid())
  email                 String             @unique
  role                  String             @default("USER") // SUPERADMIN, HOST_MANAGER, RESTAURANT_MANAGER, TRAINING_MANAGER, TEACHER, EVENT_MANAGER, ADMINISTRATION, RIDER, USER
  type                  String             @default("PRIVATE") // PRIVATE, COMPANY
  archived              Boolean            @default(false)
  name                  String?
  surname               String?
  phone                 String?
  taxCode               String?            // Codice Fiscale or P.IVA
  companyName           String?            // Ragione Sociale (Azienda)
  sdiPec                String?            // PEC or SDI code (Azienda)
  bio                   String?            // Teacher biography
  competencies          String?            // Teacher competencies
  
  // Addresses
  residenceAddress      String?
  residenceCity         String?
  residenceZip          String?
  residenceProvince     String?
  
  billingAddress        String?
  billingCity           String?
  billingZip            String?
  billingProvince       String?
  billingSameAsResidence Boolean           @default(true)
  
  shippingAddress       String?
  shippingCity          String?
  shippingZip           String?
  shippingProvince      String?
  
  // Dietary & Preferences
  diet                  String?            // VEGAN, VEGETARIAN, GLUTEN_FREE, etc.
  mealVouchers          Boolean            @default(false)
  
  // Relations
  enrollments           CourseEnrollment[]
  teachesCourses        Course[]           @relation("TeacherCourses")
  teachesLessons        Lesson[]           @relation("TeacherLessons")
  reservations          TableReservation[]
  materialsUploaded     CourseMaterial[]   @relation("UploaderMaterials")
  
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}

// 2. Tassonomie (SuperAdmin Configs)
model TemplateType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model MealTimeSlot {
  id        String   @id @default(cuid())
  name      String   @unique // Colazione, Pranzo, Cena, etc.
  createdAt DateTime @default(now())
}

model BookingType {
  id        String   @id @default(cuid())
  name      String   @unique // Riunione, Accesso for Work, Evento, etc.
  hasCost   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model CourseType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model LessonType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Allergen {
  id        String     @id @default(cuid())
  name      String     @unique
  foods     Food[]     @relation("FoodAllergens")
  beverages Beverage[] @relation("BeverageAllergens")
  createdAt DateTime   @default(now())
}

// 3. Spazi (Spaces)
model Room {
  id           String           @id @default(cuid())
  name         String
  type         String           // TRAINING, MEETING, MULTI_SPACE
  availability String           // JSON representing weekly availability & exceptions
  hourlyCost   Float            @default(0.0) // For Meeting rooms
  capacity     Int              @default(0)
  
  // Relations
  templateId   String?
  template     RoomTemplate?    @relation(fields: [templateId], references: [id])
  tables       Table[]
  bookings     BookingRequest[]
  lessons      Lesson[]
  courses      Course[]
  events       Event[]
  reservations TableReservation[]
  slots        CalendarSlot[]
  services     RoomService[]

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model RoomTemplate {
  id        String   @id @default(cuid())
  name      String   // Platea, Meeting, etc.
  type      String   // Associated TemplateType name
  rooms     Room[]
  tables    Table[]  @relation("TemplateTables")
  events    Event[]
  createdAt DateTime @default(now())
}

model Table {
  id               String             @id @default(cuid())
  identifier       String             // T1, T2, etc.
  capacity         Int
  roomId           String
  room             Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  
  // Template relation
  templates        RoomTemplate[]     @relation("TemplateTables")
  
  // Merge relation (self M2M)
  associatedTables Table[]            @relation("TableMerges")
  mergesWith       Table[]            @relation("TableMerges")
  
  reservations     TableReservation[]

  createdAt        DateTime           @default(now())
}

model TechnicalService {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      String        @default("AVAILABLE") // AVAILABLE, MAINTENANCE
  cost        Float         @default(0.0) // Included in event/meeting cost
  rooms       RoomService[]
  events      Event[]       @relation("EventServices")
  createdAt   DateTime      @default(now())
}

model RoomService {
  roomId             String
  room               Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  technicalServiceId String
  technicalService   TechnicalService @relation(fields: [technicalServiceId], references: [id], onDelete: Cascade)

  @@id([roomId, technicalServiceId])
}

model BookingRequest {
  id              String   @id @default(cuid())
  requester       String   // Name or company name
  type            String   // From BookingType
  date            DateTime
  guests          Int
  durationMinutes Int
  endTime         DateTime
  cost            Float    @default(0.0)
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  checkedIn       Boolean  @default(false)
  
  roomId          String
  room            Room     @relation(fields: [roomId], references: [id])
  
  createdAt       DateTime @default(now())
}

// 4. Calendario (Calendar)
model CalendarSlot {
  id         String   @id @default(cuid())
  type       String   // EVENT, MEETING, LESSON
  startDate  DateTime
  endDate    DateTime
  status     String   @default("DRAFT") // DRAFT, PUBLISHED, CANCELLED
  
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id])
  
  eventId    String?  @unique
  event      Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// 5. Formazione (Training)
model Course {
  id               String             @id @default(cuid())
  name             String
  description      String
  courseType       String             // From CourseType
  duration         Float              // total hours
  lessonsCount     Int
  published        Boolean            @default(false)
  featured         Boolean            @default(false)
  weeklyDay        String?            // e.g. Lunedì
  lessonsRecurring Boolean            @default(false)
  cost             Float              @default(0.0)
  maxStudents      Int                @default(15)
  image            String?            // data URL or external URL
  
  teacherId        String?
  teacher          User?              @relation("TeacherCourses", fields: [teacherId], references: [id])
  roomId           String?
  room             Room?              @relation(fields: [roomId], references: [id])
  
  lessons          Lesson[]
  enrollments      CourseEnrollment[]
  materials        CourseMaterial[]

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model Lesson {
  id           String             @id @default(cuid())
  lessonNumber Int
  description  String?
  lessonType   String             // From LessonType
  published    Boolean            @default(false)
  date         DateTime
  timeSlot     String?            // From MealTimeSlot (fascia oraria)
  duration     Int                // in minutes
  
  courseId     String
  course       Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId    String?
  teacher      User?              @relation("TeacherLessons", fields: [teacherId], references: [id])
  roomId       String?
  room         Room?              @relation(fields: [roomId], references: [id])
  
  attendances  LessonAttendance[]
  materials    CourseMaterial[]

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model CourseEnrollment {
  id           String             @id @default(cuid())
  status       String             @default("PENDING") // PENDING, ACCEPTED, REJECTED
  cvUrl        String?            // data URL (mock PDF)
  cvFileName   String?
  
  studentName  String?
  studentEmail String?
  
  userId       String?
  user         User?              @relation(fields: [userId], references: [id])
  courseId     String
  course       Course             @relation(fields: [courseId], references: [id])
  
  attendances  LessonAttendance[]

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model LessonAttendance {
  enrollmentId String
  enrollment   CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  present      Boolean          @default(false)

  @@id([enrollmentId, lessonId])
}

model CourseMaterial {
  id         String   @id @default(cuid())
  name       String
  url        String   // data URL or external URL
  type       String   // PDF, VIDEO, LINK
  
  courseId   String?
  course     Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId   String?
  lesson     Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  uploaderId String?
  uploader   User?    @relation("UploaderMaterials", fields: [uploaderId], references: [id])

  createdAt  DateTime @default(now())
}

// 6. Ristorazione (Food & Beverage)
model Menu {
  id           String             @id @default(cuid())
  name         String
  dietType     String             // VEGAN, VEGETARIAN, GLUTEN_FREE, standard
  timeSlot     String             // From MealTimeSlot
  image        String?
  cost         Float              @default(0.0)
  
  foods        Food[]             @relation("MenuFoods")
  beverages    Beverage[]         @relation("MenuBeverages")
  
  events       Event[]
  reservations TableReservation[]

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model Food {
  id          String     @id @default(cuid())
  name        String
  ingredients String
  quantity    Float      @default(0)
  unit        String     @default("PZ") // KG, L, PZ
  image       String?
  cost        Float?
  
  menus       Menu[]     @relation("MenuFoods")
  allergens   Allergen[] @relation("FoodAllergens")

  createdAt   DateTime   @default(now())
}

model Beverage {
  id          String     @id @default(cuid())
  name        String
  ingredients String
  quantity    Float      @default(0)
  unit        String     @default("PZ") // KG, L, PZ
  image       String?
  cost        Float?
  
  menus       Menu[]     @relation("MenuBeverages")
  allergens   Allergen[] @relation("BeverageAllergens")

  createdAt   DateTime   @default(now())
}

model TableReservation {
  id             String   @id @default(cuid())
  status         String   @default("CONFIRMED") // CONFIRMED, SEATED, CANCELLED
  checkedIn      Boolean  @default(false)
  guests         Int
  timeSlot       String   // From MealTimeSlot
  date           DateTime
  mergedTableIds String?  // JSON string array of IDs of merged tables
  
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  tableId        String?
  table          Table?   @relation(fields: [tableId], references: [id])
  menuId         String?
  menu           Menu?    @relation(fields: [menuId], references: [id])
  eventId        String?
  event          Event?   @relation(fields: [eventId], references: [id])
  roomId         String?
  room           Room?    @relation(fields: [roomId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// 7. Eventi
model Event {
  id             String             @id @default(cuid())
  name           String
  description    String
  type           String             // Event Type
  image          String?
  timeSlot       String             // From MealTimeSlot
  date           DateTime
  cost           Float              @default(0.0)
  notes          String?
  
  roomId         String?
  room           Room?              @relation(fields: [roomId], references: [id])
  menuId         String?
  menu           Menu?              @relation(fields: [menuId], references: [id])
  templateId     String?
  template       RoomTemplate?      @relation(fields: [templateId], references: [id])
  
  calendarSlotId String?
  calendarSlot   CalendarSlot?
  
  services       TechnicalService[] @relation("EventServices")
  reservations   TableReservation[]

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}
